  "lessons": [
    {
      "id": 1,
      "chapterId": "ch-00",
      "lessonNumber": 1,
      "title": "Bài 1: Nhận biết một số dụng cụ, hoá chất. Thuyết trình một vấn đề khoa học",
      "subject": "mo_dau",
      "periods": 4,
      "objectives": [
        "Nhận biết được một số dụng cụ và hoá chất sử dụng trong dạy học môn Khoa học tự nhiên 9.",
        "Trình bày được các bước viết và trình bày báo cáo; làm được bài thuyết trình một vấn đề khoa học."
      ],
      "coreConcepts": [
        "Dụng cụ quang học & điện từ: Nguồn sáng, bản bán trụ, bảng chia độ (nghiên cứu khúc xạ/phản xạ toàn phần); tiêu bản NST người; cuộn dây dẫn có đèn LED.",
